#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
        comquest: comma_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        dotex: dot_exclamation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sslash: super_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  F       │  P       │  B       │   │  J       │  L       │  U       │  Y       │  ;       │
            &kp Q      &kp W     &lt 3 F      &kp P      &kp B          &kp J      &kp L     &lt 3 U    &kp Y      &kp SEMI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  R       │  S       │  T       │  G       │   │  M       │  N       │  E       │  I       │  O       │
          &mt LSHIFT A &kp R      &lt 2 S    &lt 1 T    &kp G          &kp M      &lt 1 N    &lt 2 E    &kp I    &mt RSHIFT O
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │  C       │  D       │  V       │   │  K       │  H       │ , ?      │ . !      │ / \      │
            &kp Z      &kp X      &kp C      &kp D      &kp V          &kp K      &kp H      &comquest  &dotex    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                       &mt LGUI BSPC &mt LALT SPACE &mt LCTL RET &mt RGUI TAB
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        num_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ ESC      │ Page Up  │  UP      │Page down │ Calc     │   │  7       │  8       │  9       │  0       │  *       │
            &kp ESC    &kp PG_UP   &kp UP  &kp PG_DN &kp K_CALC      &kp N7      &kp N8       &kp N9   &kp N0    &kp STAR
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│ SHIFT    │  LEFT    │  DOWN    │  RIGHT   │Gamer Mode│   │ 4        │ 5        │ 6        │ / ?      │  - _     │
           &kp LSHIFT  &kp LEFT  &kp DOWN    &kp RIGHT  &none          &kp N4       &kp N5     &kp N6    &kp FSLH   &kp MINUS
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│ CAPS     │  Ins     │  Del     │  HOME    │  End     │   │  1       │  2       │   3      │    .     │    +     │
           &kp CAPS   &kp INS    &kp DEL    &kp HOME   &kp END         &kp N1     &kp N2     &kp N3      &kp DOT    &kp PLUS
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans        &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        sym_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Esc     │  @       │  [       │  ]       │   ~      │   │  ^       │  `       │          │          │   :      │
            &kp ESC   &kp AT     &kp LBKT   &kp RBKT   &kp TILDE      &kp CARET  &kp GRAVE   &none      &none     &kp COLON
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│    <     │    >     │  (       │   )      │   &      │   │  =       │  '       │          │  %       │  _       │
         &mt LSHIFT LT  &kp GT    &kp RPAR   &kp LPAR   &kp AMPS      &kp EQUAL   &kp SQT      &none    &kp PRCNT  &kp UNDER
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│   CAPS    │  #       │    {     │    }     │   |      │   │  $       │  "       │    ?     │  !       │    \     │
            &kp CAPS     &kp HASH   &kp LBRC   &kp RBRC   &kp PIPE       &kp DLLR   &kp DQT   &kp QMARK   &kp EXCL    &kp BSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        f_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │ Bright + │          │  Vol +   |PROFILE 0 │   │    F7    │  F8      │   F9     │  F12     │  Sleep   │
            &none   &kp C_BRI_UP   &none  &kp K_VOL_UP &bt BT_SEL 0    &kp F7     &kp F8     &kp F9     &kp F12 &kp K_SLEEP
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │ Bright - │          │  Vol -   │PROF NEXT │   │  F4      │  F5      │  F6      │   F11    │   Lock   │
             &none   &kp C_BRI_DN   &none &kp K_VOL_DN &bt BT_NXT      &kp F4     &kp F5     &kp F6     &kp F11 &kp K_LOCK
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│ BOOTLDR             │          │  Mute    │ BT Clear |   │   F1     │  F2      │  F3      │  F10     │ BOOTLDR  │
          &bootloader    &none      &none   &kp K_MUTE &bt BT_CLR       &kp F1     &kp F2     &kp F3     &kp F10  &bootloader
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                            &trans     &trans         &trans     &trans
      //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
